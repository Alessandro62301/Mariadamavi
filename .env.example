# Sessão do /buscador (login validado contra o banco)
AUTH_SECRET=troque-por-um-valor-aleatorio-longo
BUSCADOR_USER=
BUSCADOR_PASS=

# API upstream do buscador (Conecta Lojista/BuskaPhone, roda em cima do
# Supabase). Deixar em branco usa dados de exemplo (mock) automaticamente.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Só é necessário na primeira vez / se a tabela ApiSession estiver vazia —
# depois disso o app persiste e renova o token sozinho no banco.
SUPABASE_REFRESH_TOKEN=

# MySQL (container "db" do docker-compose)
MYSQL_ROOT_PASSWORD=troque-esta-senha
MYSQL_DATABASE=mavi
MYSQL_USER=mavi
MYSQL_PASSWORD=troque-esta-senha-tambem

# String de conexão usada pelo Prisma. Em Docker, o host é o nome do
# serviço ("db"); rodando local sem Docker, troque por localhost.
DATABASE_URL="mysql://mavi:troque-esta-senha-tambem@db:3306/mavi"
