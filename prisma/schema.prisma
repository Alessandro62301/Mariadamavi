generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int               @id @default(autoincrement())
  email        String            @unique
  password     String
  nome         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  alertas      AlertaPreco[]
  telegram     TelegramVinculo?
  preferencias PreferenciaBusca?
}

// Guarda a sessão da API upstream (Supabase do Conecta Lojista/BuskaPhone).
// O refresh_token gira a cada uso — sem persistir, o token do .env vira
// inválido depois do primeiro uso e quebra a integração num restart.
model ApiSession {
  id           Int       @id @default(autoincrement())
  provider     String    @unique
  accessToken  String?   @db.Text
  refreshToken String    @db.Text
  expiresAt    DateTime?
  updatedAt    DateTime  @updatedAt
}

model OfertaCache {
  id              Int       @id
  modelo          String
  modeloBase      String
  categoria       String
  condicao        String
  cor             String
  variante        String?
  armazenamento   String?
  cidade          String
  estado          String?
  valor           String
  valorNum        Decimal   @db.Decimal(12, 2)
  fotoUrl         String    @db.Text
  dataAtualizacao String
  createdAtOrigem DateTime?
  verificado      Boolean   @default(false)
  fornecedor      String?
  atualizadoEm    DateTime  @default(now())

  @@index([categoria])
  @@index([modeloBase])
  @@index([condicao])
  @@index([armazenamento])
  @@index([estado, cidade])
  @@index([valorNum])
}

model CacheControle {
  chave        String   @id @db.VarChar(64)
  atualizadoEm DateTime @default(now())
  total        Int      @default(0)
  cidades      Int      @default(0)
  fornecedores Int      @default(0)
}

model AlertaPreco {
  id               Int             @id @default(autoincrement())
  userId           Int
  categoria        String?
  modeloBusca      String?
  condicaoDesejada String?
  precoAlvo        Decimal         @db.Decimal(12, 2)
  canalEmail       Boolean         @default(true)
  canalTelegram    Boolean         @default(false)
  ativo            Boolean         @default(true)
  criadoEm         DateTime        @default(now())
  atualizadoEm     DateTime        @updatedAt
  ultimoDisparoEm  DateTime?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  disparos         AlertaDisparo[]

  @@index([userId, ativo])
}

model AlertaDisparo {
  id        Int         @id @default(autoincrement())
  alertaId  Int
  ofertaId  Int
  canal     String      @db.VarChar(16)
  status    String      @db.VarChar(16)
  erro      String?     @db.Text
  criadoEm  DateTime    @default(now())
  enviadoEm DateTime?
  alerta    AlertaPreco @relation(fields: [alertaId], references: [id], onDelete: Cascade)

  @@unique([alertaId, ofertaId, canal])
  @@index([status, criadoEm])
}

model TelegramVinculo {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  chatId         String?   @unique @db.VarChar(64)
  username       String?
  codigo         String?   @unique @db.VarChar(64)
  codigoExpiraEm DateTime?
  vinculadoEm    DateTime?
  contextoBusca  Json?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramConversaPublica {
  chatId               String    @id @db.VarChar(64)
  username             String?
  contextoBusca        Json?
  contextoAtualizadoEm DateTime?
  ultimaMensagemEm     DateTime?
  janelaInicio         DateTime  @default(now())
  mensagensNaJanela    Int       @default(0)
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt
}

model PreferenciaBusca {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  visualizacaoPadrao String   @default("lista") @db.VarChar(16)
  itensPorPagina     Int      @default(25)
  categoriaPadrao    String   @default("iphone")
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
