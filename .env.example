# Sessão do /buscador (login validado contra o banco)
AUTH_SECRET=troque-por-um-valor-aleatorio-longo
BUSCADOR_USER=
BUSCADOR_PASS=

# API upstream do buscador (Conecta Lojista/BuskaPhone, roda em cima do
# Supabase). Deixar em branco usa dados de exemplo (mock) automaticamente.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Só é necessário na primeira vez / se a tabela ApiSession estiver vazia —
# depois disso o app persiste e renova o token sozinho no banco.
SUPABASE_REFRESH_TOKEN=

# MySQL (container "db" do docker-compose)
MYSQL_ROOT_PASSWORD=troque-esta-senha
MYSQL_DATABASE=mavi
MYSQL_USER=mavi
MYSQL_PASSWORD=troque-esta-senha-tambem

# String de conexão usada pelo Prisma. Em Docker, o host é o nome do
# serviço ("db"); rodando local sem Docker, troque por localhost.
DATABASE_URL="mysql://mavi:troque-esta-senha-tambem@db:3306/mavi"

# URL pública usada nos links enviados pelos alertas.
APP_URL=https://mariadamavi.com.br

# Job horário de cache + alertas. Use um valor aleatório longo.
CRON_SECRET=

# E-mail (Resend). Enquanto vazios, o canal aparece como indisponível.
RESEND_API_KEY=
ALERT_EMAIL_FROM="MARIADAMAVI <alertas@seudominio.com>"

# Telegram Bot API. TELEGRAM_BOT_USERNAME não leva @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Interpreta as conversas do bot. Preços e disponibilidade continuam vindo do MySQL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Site Rastreio — a URL exata e a chave aparecem no painel após o cadastro.
# Use {codigo} no ponto em que o código deve entrar.
SITERASTREIO_API_URL=
SITERASTREIO_API_KEY=
SITERASTREIO_AUTH_HEADER=Authorization
SITERASTREIO_AUTH_PREFIX="Bearer "
